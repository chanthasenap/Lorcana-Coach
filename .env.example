# --- Database ---
# Local dev: point at the sandbox's local Postgres (see README).
# Production: use your Neon connection string (Neon dashboard -> Connection Details -> "Pooled connection").
DATABASE_URL="postgresql://lorcana:lorcana_dev_pw@localhost:5432/lorcana_coach"

# --- Discord Application (Developer Portal -> your app) ---
DISCORD_APPLICATION_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_BOT_TOKEN=""
# OAuth (Developer Portal -> OAuth2), used for web dashboard "Sign in with Discord"
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Optional: your team's Discord server ID. When set, `npm run discord:register`
# registers commands to just this server so they appear instantly (great for
# dev). Leave blank for production/global registration (~1hr to propagate).
DISCORD_DEV_GUILD_ID=""

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- AI Providers ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Per-task provider:model routing. Format "<provider>:<model>".
# Providers: anthropic | openai
# Haiku is used for high-frequency/cheap tasks, Sonnet for deeper analysis - keeps AI cost low.
AI_TASK_SCENARIO_GENERATION="anthropic:claude-haiku-4-5"
AI_TASK_GAME_ANALYSIS="anthropic:claude-sonnet-5"
AI_TASK_COACHING="anthropic:claude-haiku-4-5"
AI_TASK_RULES="anthropic:claude-haiku-4-5"
AI_TASK_PATTERN_DETECTION="anthropic:claude-sonnet-5"
AI_TASK_TEAM_STRATEGY="anthropic:claude-sonnet-5"

# Optional: Discord webhook for automated team summaries (e.g. #results channel)
DISCORD_RESULTS_WEBHOOK_URL=""

# --- One-time production setup ---
# Protects /api/admin/* routes (migrate/seed/register-commands). Generate with:
# openssl rand -hex 24
ADMIN_SETUP_SECRET=""
